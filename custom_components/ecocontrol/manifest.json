{
  "domain": "ecocontrol",
  "name": "ecoControl Floor Heating",
  "description": "Lightweight, read-only integration for Taelek Oy ecoControl Bluetooth floor heating thermostats.",
  "codeowners": ["@ivarekman"],
  "supported_by": "ecocontrol",
  "dependencies": [
    "bluetooth",
    "bluetooth_adapters"
  ],
  "config_flow": true,
  "documentation": "https://github.com/ivarekman/homeassistant-ecocontrol",
  "iot_class": "local_polling",
  "requirements": [
    "bleak>=0.21.1",
    "bleak-retry-connector>=3.5.0"
  ],
  "bluetooth": [
    {
      "manufacturer_id": 1162,
      "connectable": true
    },
    {
      "manufacturer_id": 1162,
      "connectable": false
    }
  ],
  "version": "2.3.0"
}
